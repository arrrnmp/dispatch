---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<div class="breadcrumbs">
  {items.map((item, i) => (
    <>
      {item.href ? (
        <a href={item.href}>{item.label}</a>
      ) : (
        <span class="current">{item.label}</span>
      )}
      {i < items.length - 1 && (
        <span class="sep">&rarr;</span>
      )}
    </>
  ))}
</div>
